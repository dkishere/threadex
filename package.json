{
  "name": "threadex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "serve": "npm run build && node scripts/serve.mjs",
    "serve:wsl": "node scripts/serve-wsl.mjs",
    "dev:client": "node scripts/watch-client.mjs",
    "dev:server": "node scripts/watch-server.mjs",
    "dev:server:plain": "node scripts/watch-server.mjs --no-pg-dev",
    "browser-bridge:build": "npm --prefix local-browser-bridge run build",
    "browser-bridge:start": "npm --prefix local-browser-bridge run start",
    "browser-bridge:check": "npm --prefix local-browser-bridge run check",
    "browser-bridge:test": "npm --prefix local-browser-bridge test",
    "legacy:duckdb-ui": "node scripts/duckdb-ui.mjs",
    "legacy:clean:duckdb-long-payloads": "node scripts/truncate-duckdb-long-payloads.mjs",
    "legacy:restart-clean-duckdb": "bash scripts/restart-clean-duckdb.sh",
    "build": "node node_modules/typescript/lib/tsc.js -b && node node_modules/vite/bin/vite.js build",
    "embed:session-descriptions": "node scripts/embed-session-descriptions.mjs",
    "import:local-sessions": "node scripts/import-local-sessions.mjs",
    "sync:local-sessions": "node scripts/sync-local-sessions.mjs",
    "pg:dev": "node scripts/pg-dev.mjs",
    "migrate:duckdb-to-postgres": "node --import tsx scripts/migrate-duckdb-to-postgres.mjs",
    "codex:stop-sync-hook": "node scripts/codex-stop-sync.mjs",
    "summarize:workspace-sessions": "node node_modules/tsx/dist/cli.mjs scripts/resummarize-workspace-sessions.ts",
    "mcp:session-inspector": "node node_modules/tsx/dist/cli.mjs src/server/sessionInspectorMcp.ts",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4173",
    "start": "node node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "test": "node --import tsx --test src/server/*.test.ts && node --test scripts/*.test.mjs extensions/threadex-review/*.test.js",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "node node_modules/@playwright/test/cli.js test --headed",
    "e2e:server": "node node_modules/tsx/dist/cli.mjs e2e/support/start-server.ts",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "slate": "^0.126.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0",
    "three": "^0.185.1",
    "tsx": "^4.21.0",
    "unified": "^11.0.0",
    "vite": "^7.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "dbxlite-ui": "^0.3.6",
    "typescript": "^6.0.3"
  }
}
